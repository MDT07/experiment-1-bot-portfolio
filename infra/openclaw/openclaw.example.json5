{
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    auth: {
      mode: "token",
      token: { source: "env", provider: "default", id: "OPENCLAW_GATEWAY_TOKEN" },
      rateLimit: {
        maxAttempts: 10,
        windowMs: 60000,
        lockoutMs: 300000,
        exemptLoopback: false,
      },
    },
    http: {
      endpoints: {
        chatCompletions: {
          enabled: true,
          maxBodyBytes: 32768,
          images: { allowUrl: false },
        },
      },
    },
    controlUi: {
      enabled: false,
    },
  },

  plugins: {
    entries: {
      // Install @openclaw/kimi-provider before starting the Gateway.
      kimi: { enabled: true },
    },
  },

  agents: {
    defaults: {
      // No default is selected in Git. Set OPENCLAW_MODEL only after evaluation.
      model: { primary: "${OPENCLAW_MODEL}" },
      maxConcurrent: 1,
      sandbox: {
        // This agent has no tools; do not mount a Docker socket into the Gateway.
        mode: "off",
        workspaceAccess: "none",
      },
    },
    entries: {
      studio: {
        default: true,
        identity: {
          name: "Studio Architect",
          theme: "bounded bot-system design",
        },
      },
    },
  },

  tools: {
    profile: "minimal",
    deny: ["*"],
    elevated: { enabled: false },
    exec: { security: "deny", ask: "always" },
  },

  session: {
    maintenance: {
      mode: "enforce",
      pruneAfter: "24h",
      archiveDashboardAfter: false,
      maxEntries: 500,
      resetArchiveRetention: "24h",
      maxDiskBytes: "250mb",
      highWaterBytes: "200mb",
    },
  },

  channels: {},
}
