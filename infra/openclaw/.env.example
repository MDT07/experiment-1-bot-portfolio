# Pin an audited release. Do not use latest for the production gateway.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2

# Dedicated experiment state — never point these at ~/.openclaw.
OPENCLAW_CONFIG_DIR=/srv/experiment-1-openclaw/state
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/srv/experiment-1-openclaw/auth-secrets
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_TZ=UTC

# Generate unique secrets directly on the gateway host.
OPENCLAW_GATEWAY_TOKEN=

# Kimi Code membership credential. Keep this on the persistent Gateway host;
# it is not required in Vercel and must never be prefixed with NEXT_PUBLIC_.
KIMI_API_KEY=
