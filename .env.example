# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Keep false until Supabase, OpenClaw, provider budgets, and deployment rate
# limits pass QA.
AI_DEMO_PUBLIC=false

# First live release controls. Owner-only + one blueprint run + no preview chat
# is the safest measured production baseline.
AI_DEMO_OWNER_ONLY=true
AI_DEMO_RUN_LIMIT=1
AI_DEMO_RUNS_SINCE=
AI_DEMO_CHAT_ENABLED=false

# Supabase Auth + one-shot quota storage. Use only the modern key format.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_SECRET_KEY=sb_secret_
STUDIO_OWNER_USER_ID=
STUDIO_OWNER_EMAIL=emirsemenov@yahoo.com

# Narrow HTTPS bridge in front of the private OpenClaw Gateway. The bridge URL
# is an origin/base URL; the app appends /studio/v1/generate. Never place the
# operator-level OPENCLAW_GATEWAY_TOKEN or KIMI_API_KEY in Vercel.
OPENCLAW_BRIDGE_URL=
OPENCLAW_BRIDGE_TOKEN=

# Non-secret audit label. Leave blank until an exact model is selected on the
# persistent OpenClaw host; blank keeps Studio fail-closed.
OPENCLAW_MODEL_LABEL=
