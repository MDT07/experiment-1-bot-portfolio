# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Public Bot Studio model route. The credential remains server-only.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Keep false until Supabase, provider budgets, and deployment rate limits pass QA.
AI_DEMO_PUBLIC=false

# Supabase Auth + one-shot quota storage. Use only the modern key format.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_SECRET_KEY=sb_secret_
STUDIO_OWNER_USER_ID=
STUDIO_OWNER_EMAIL=emirsemenov@yahoo.com

# Optional owner control-plane link to a separately hosted OpenClaw Gateway.
# Never expose either value with a NEXT_PUBLIC_ prefix.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=kimi/kimi-for-coding
