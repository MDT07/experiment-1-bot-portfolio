# Optional canonical URL, without a trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Server-only NVIDIA Build credential. Never prefix this variable with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Keep false until production rate limiting is configured and verified.
AI_DEMO_PUBLIC=false

# Owner-only /ops authentication. Use long, unique production values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OpenClaw remains on a separate persistent host; Vercel only renders its owner console.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
